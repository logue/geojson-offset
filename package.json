{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "geojson-offset-ts",
  "version": "0.4.2",
  "description": "Add offset to the coordinates of GeoJSON.",
  "keywords": [
    "geojson",
    "feature",
    "geometry",
    "coordinate",
    "offset"
  ],
  "homepage": "https://github.com/logue/geojson-offset",
  "bugs": {
    "url": "https://github.com/logue/geojson-offset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/geojson-offset.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev"
  },
  "contributors": [
    {
      "name": "Haoliang Yu",
      "email": "haholiang.yu@outlook.com"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rs dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "analyze": "RSDOCTOR=true rs lib",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rs lib",
    "preview": "rs preview",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepare": "rs hooks"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsdoctor/cli": "^1.6.4",
    "@rsdoctor/core": "^1.6.4",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rstest/core": "^0.12.3",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/geojson": ">=7946.0.16"
  },
  "packageManager": "pnpm@12.8.1"
}
